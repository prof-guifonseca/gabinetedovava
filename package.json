{
  "name": "gabinetedovava",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:pages": "vite build && node scripts/prepare-pages.mjs",
    "deploy": "vite build && node scripts/prepare-pages.mjs && wrangler pages deploy dist/pages --project-name=gabinetedovava --branch=main",
    "deploy:worker": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
